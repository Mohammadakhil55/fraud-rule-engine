# ========================================================
# FraudShield Environment Variables
# ========================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True
APP_NAME=FraudShield
API_V1_STR=/api

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate via: openssl rand -hex 32
SECRET_KEY=demo_super_secret_key_change_in_production_32bytes_min
JWT_SECRET=demo_jwt_secret_key_change_in_production_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/fraudshield
# SQLite (Local Dev fallback): sqlite:///./fraudshield.db
DATABASE_URL=sqlite:///./fraudshield.db
USE_SQLITE=True

# CORS Configuration (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Notification Provider (mock | ses | sns)
NOTIFICATION_PROVIDER=mock
ALERT_EMAIL_RECIPIENT=fraud-alerts@company.example.com

# AWS Credentials (Optional, required only if NOTIFICATION_PROVIDER is ses or sns)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
AWS_SNS_TOPIC_ARN=
